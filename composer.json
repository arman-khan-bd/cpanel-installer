{
    "name": "nexus-lab/cpanel-installer",
    "description": "Zero-SSH graphical web installer for Nexus applications on cPanel shared hosting.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "nexus",
        "nexus-lab",
        "cpanel",
        "installer",
        "zero-ssh",
        "shared-hosting",
        "setup-wizard"
    ],
    "authors": [
        {
            "name": "Nexus Architecture Team",
            "role": "Package Architect & Application Security"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-pdo": "*",
        "ext-json": "*",
        "nexus-lab/nexus": "^1.0 || ^2.0"
    },
    "suggest": {
        "ext-sodium": "Recommended for native Libsodium cryptographic operations (XChaCha20-Poly1305)",
        "ext-pdo_mysql": "Required to connect to cPanel MySQL and MariaDB databases",
        "ext-openssl": "Fallback cryptographic engine when native sodium is restricted",
        "ext-mbstring": "Recommended for full Unicode and multibyte support",
        "ext-fileinfo": "Required for upload MIME inspection"
    },
    "autoload": {
        "psr-4": {
            "Nexus\\Installer\\": "src/",
            "NextPHP\\Installer\\": "src/"
        }
    },
    "bin": [
        "bin/cpanel-installer"
    ],
    "extra": {
        "nextphp": {
            "providers": [
                "NextPHP\\Installer\\InstallerServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
